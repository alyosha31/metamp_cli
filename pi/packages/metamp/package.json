{
	"name": "metamp",
	"version": "0.1.0",
	"description": "ML/data-science copilot workbench on the Pi coding-agent harness",
	"type": "module",
	"bin": {
		"metamp": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extension": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm --prefix ../tui run build && npm --prefix ../ai run build && npm --prefix ../agent run build && npm --prefix ../coding-agent run build && tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.75.5",
		"typebox": "1.1.38",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"keywords": [
		"machine-learning",
		"data-science",
		"copilot",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi-mono.git",
		"directory": "packages/metamp"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
